# Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps > App web).
# Estos valores NO son secretos (identifican el proyecto); la seguridad real está en
# Firebase Authentication + reglas de Firestore. Nunca pongas aquí claves de servicio (Admin SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: solo si App Check está ACTIVADO (enforcement) en Firestore del proyecto.
# Clave de sitio reCAPTCHA v3 registrada para el dominio de esta app.
VITE_RECAPTCHA_SITE_KEY=
